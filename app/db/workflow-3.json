    {
      "parameters": {
        "jsCode": "const studentId = $('Parse Booking Selection').item.json.student_id;\nconst submissionData = $('Get Intake Submission').item.json;\n\n// Generate assessment URL\nconst baseUrl = 'https://docs.google.com/forms/d/YOUR_ASSESSMENT_FORM_ID/viewform';\nconst params = new URLSearchParams({\n  'entry.student_id': studentId,\n  'entry.name': submissionData.Child_Name,\n  'entry.subject': submissionData.Subject,\n  'entry.year': submissionData.Year\n});\n\nconst assessmentUrl = `${baseUrl}?${params.toString()}`;\n\nreturn {\n  json: {\n    assessment_url: assessmentUrl,\n    student_id: studentId,\n    child_name: submissionData.Child_Name\n  }\n};"
      },
