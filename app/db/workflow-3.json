        "message": "=<!DOCTYPE html>\n<html>\n<head>\n  <style>\n    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }\n    .container { max-width: 600px; margin: 0 auto; padding: 20px; background: #f9f9f9; }\n    .header { background: #2c3e50; color: white; padding: 20px; text-align: center; }\n    .student-info { background: white; padding: 20px; margin: 20px 0; border-left: 4px solid #3498db; }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <div class=\"header\">\n      <h2>👨‍🎓 New Student Enrollment</h2>\n    </div>\n    \n    <div class=\"student-info\">\n      <h3>Student Information</h3>\n      <p><strong>Name:</strong> {{ $('Get Intake Submission').item.json.Child_Name }}</p>\n      <p><strong>Age:</strong> {{ $('Get Intake Submission').item.json.Child_Age }}</p>\n      <p><strong>Year:</strong> {{ $('Get Intake Submission').item.json.Year }}</p>\n      <p><strong>Subject:</strong> {{ $('Get Intake Submission').item.json.Subject }}</p>\n      \n      <h3>Learning Profile</h3>\n      <p><strong>Current Challenges:</strong> {{ $('Get Intake Submission').item.json.Challenges }}</p>\n      <p><strong>Learning Goals:</strong> {{ $('Get Intake Submission').item.json.Goals }}</p>\n      \n      <h3>Session Details</h3>\n      <p><strong>Type:</strong> {{ $('Parse Booking Selection').item.json.option_type }}</p>\n      <p><strong>Schedule:</strong> {{ $('Parse Booking Selection').item.json.schedule }}</p>\n      <p><strong>Booking ID:</strong> {{ $('Parse Booking Selection').item.json.booking_id }}</p>\n      \n      <h3>Parent Contact</h3>\n      <p><strong>Parent:</strong> {{ $('Get Intake Submission').item.json.Parent_Name }}</p>\n      <p><strong>Email:</strong> {{ $('Get Intake Submission').item.json.Parent_Email }}</p>\n      <p><strong>Phone:</strong> {{ $('Get Intake Submission').item.json.Parent_Phone }}</p>\n    </div>\n    \n    <p><strong>⚠️ Important:</strong> The student will complete an assessment before the first