    {
      "parameters": {
        "subject": "=Booking Confirmed: {{ $('Get Intake Submission').item.json.Child_Name }}'s Tutoring Session 🎉",
        "message": "=<!DOCTYPE html>\n<html>\n<head>\n  <style>\n    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }\n    .container { max-width: 600px; margin: 0 auto; padding: 20px; }\n    .header { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 30px; text-align: center; border-radius: 10px 10px 0 0; }\n    .content { background: #f9f9f9; padding: 30px; border-radius: 0 0 10px 10px; }\n    .button { display: inline-block; padding: 15px 30px; background: #667eea; color: white; text-decoration: none; border-radius: 5px; font-weight: bold; margin: 20px 0; }\n    .info-box { background: white; padding: 20px; border-left: 4px solid #667eea; margin: 20px 0; }\n    .footer { text-align: center; padding: 20px; font-size: 12px; color: #666; }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <div class=\"header\">\n      <h1>🎓 Booking Confirmed!</h1>\n    </div>\n    \n    <div class=\"content\">\n      <h2>Hi {{ $('Get Intake Submission').item.json.Parent_Name }}! 👋</h2>\n      \n      <p>Great news! We've successfully confirmed {{ $('Get Intake Submission').item.json.Child_Name }}'s tutoring session.</p>\n      \n      <div class=\"info-box\">\n        <h3>📋 Session Details</h3>\n        <p><strong>Type:</strong> {{ $('Parse Booking Selection').item.json.option_type }}</p>\n        <p><strong>Subject:</strong> {{ $('Get Intake Submission').item.json.Subject }}</p>\n        <p><strong>Schedule:</strong> {{ $('Parse Booking Selection').item.json.schedule }}</p>\n        <p><strong>Booking ID:</strong> {{ $('Parse Booking Selection').item.json.booking_id }}</p>\n      </div>\n      \n      <h3>🎯 Next Step: Free Assessment</h3>\n      <p>Before the first session, please have {{ $('Get Intake Submission').item.json.Child_Name }} complete our quick assessment. This helps our tutor personalize the learning experience.</p>\n      \n      <div style=\"text-align: center;\">\n        <a href=\"{{ $('Generate Assessment Link').item.json.assessment_url }}\" class=\"button\">Start Assessment (10 minutes)</a>\n      </div>\n      \n      <div class=\"info-box\">\n        <h3>✅ What's Included</h3>\n        <ul>\n          <li>Personalized learning plan</li>\n          <li>Progress tracking</li>\n          <li>Regular parent updates</li>\n          <li>Flexible rescheduling (24hr notice)</li>\n        </ul>\n      </div>\n      \n      <p style=\"margin-top: 30px;\">We're excited to support {{ $('Get Intake Submission').item.json.Child_Name }}'s learning journey!</p>\n      \n      <p>If you have any questions, simply reply to this email or call us at <strong>[YOUR PHONE]</strong>.</p>\n      \n      <p style=\"margin-top: 20px;\">Best regards,<br><strong>ClassMatch Tutoring Team</strong></p>\n    </div>\n    \n    <div class=\"footer\">\n      <p>© 2025 ClassMatch Tutoring | <a href=\"#\">Privacy Policy</a> | <a href=\"#\">Terms of Service</a></p>\n    </div>\n  </div>\n</body>\n</html>",
        "options": {}
      },
