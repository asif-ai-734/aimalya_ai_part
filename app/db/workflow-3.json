      "parameters": {
        "jsCode": "// Parse the booking data from button click or URL\nconst input = $input.first().json;\n\nlet bookingData;\n\nif (input.body && input.body.value) {\n  // From Slack button\n  bookingData = JSON.parse(input.body.value);\n} else if (input.query) {\n  // From URL parameters\n  bookingData = input.query;\n} else {\n  throw new Error('Invalid booking data format');\n}\n\nconst bookingId = 'B' + Date.now();\nconst studentId = 'S' + Date.now();\n\nreturn {\n  json: {\n    booking_id: bookingId,\n    student_id: studentId,\n    submission_id: bookingData.submission_id,\n    option_number: parseInt(bookingData.option_number),\n    option_id: bookingData.option_id,\n    option_type: bookingData.option_type,\n    schedule: bookingData.schedule,\n    parent_email: bookingData.parent_email,\n    child_name: bookingData.child_name\n  }\n};"
      },
